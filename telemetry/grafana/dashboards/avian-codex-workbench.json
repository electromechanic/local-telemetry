        "defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}},
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "displayName", "value": "Collector"}, {"id": "mappings", "value": [{"options": {"0": {"color": "red", "index": 0, "text": "Collector unavailable"}, "1": {"color": "green", "index": 1, "text": "Collector healthy"}}, "type": "value"}]}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "displayName", "value": "Transport"}, {"id": "mappings", "value": [{"options": {"0": {"color": "red", "index": 0, "text": "Transport probe failed or stale"}, "1": {"color": "green", "index": 1, "text": "Transport probe passed"}}, "type": "value"}]}]},
          {"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "displayName", "value": "Codex completion"}, {"id": "mappings", "value": [{"options": {"0": {"color": "blue", "index": 0, "text": "Healthy; waiting for completed response"}, "1": {"color": "green", "index": 1, "text": "Authentic Codex telemetry observed"}}, "type": "value"}]}]}
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 75},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "avian-prometheus"}, "editorMode": "code", "expr": "((time() - max(timestamp(otelcol_process_uptime_total)) < bool 45) or on() vector(0))", "instant": true, "legendFormat": "Collector", "range": false, "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "avian-prometheus"}, "editorMode": "code", "expr": "((time() - max(max_over_time(timestamp(avian_telemetry_transport_probe_total{job=\"avian-telemetry-probe\", avian_synthetic=\"true\"})[30m:])) < bool 1800) or on() vector(0))", "instant": true, "legendFormat": "Transport", "range": false, "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "avian-prometheus"}, "editorMode": "code", "expr": "((sum(count_over_time(codex_websocket_event_total{job=~\"codex_cli_rs|codex_exec\", kind=\"response.completed\", success=\"true\"}[30m])) > bool 0) or on() vector(0))", "instant": true, "legendFormat": "Codex completion", "range": false, "refId": "C"}
      ],
      "title": "Local ingestion health",
      "type": "stat"
