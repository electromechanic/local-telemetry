# Optional overrides for telemetry/opencode/avian_local_telemetry.js v2.0.0.
# The setup command uses these loopback-safe defaults without requiring a file.
AVIAN_OPENCODE_OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318

# Provider IDs are classified only when explicitly listed or present in the
# plugin's documented built-in allowlists. Unknown/custom providers omit the
# locality dimension rather than guessing.
AVIAN_OPENCODE_LOCAL_PROVIDERS=ollama
AVIAN_OPENCODE_REMOTE_PROVIDERS=openai,anthropic,google,opencode,openrouter
